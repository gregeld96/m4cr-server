generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Status {
  id         Int       @id @default(autoincrement())
  name       String
  category   String
  userStatus User[]
  content    Content[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([id])
  @@map("status")
}

model Role {
  id          String           @id
  name        String
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime?        @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  @@index([id])
  @@map("roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime?  @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@index([id])
  @@map("role_permissions")
}

model Permission {
  id        Int              @id @default(autoincrement())
  name      String
  method    String
  role      RolePermission[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime?        @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  @@index([id])
  @@map("permissions")
}

model MediaFile {
  id            Int                 @id @default(autoincrement())
  name          String
  description   String?             @db.Text()
  mimetype      String
  category      String
  locationFile  String              @map("location_file")
  size          String?
  width         String?
  height        String?
  profiles      User[]
  contents      Content[]
  medias        ContentMedia[]
  followers     Follower[]
  feedbackforms FeedbackFormMedia[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime?           @map("updated_at")
  deletedAt     DateTime?           @map("deleted_at")

  @@index([id, name])
  @@map("media_files")
}

model Follower {
  id             String         @id
  email          String         @unique
  password       String
  firstName      String         @map("first_name")
  lastName       String?        @map("last_name")
  profilePhoto   MediaFile?     @relation(fields: [profilePhotoId], references: [id])
  profilePhotoId Int?           @map("profile_photo_id")
  gender         String?
  phone          String?
  socialMedia    String?        @map("social_media")
  socialLink     String?        @map("social_link")
  reference      String?
  subscribeNews  Boolean        @default(true) @map("subscribe_news")
  feedbacks      FeedbackForm[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime?      @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  @@index([email, id])
  @@map("followers")
}

model FeedbackForm {
  id         Int                 @id @default(autoincrement())
  type       String
  follower   Follower?           @relation(fields: [followerId], references: [id])
  followerId String?             @map("follower_id")
  province   String?
  city       String?
  district   String?
  urban      String?
  latitude   Float?
  longitude  Float?
  link       String?
  title      String?
  content    String?             @db.Text
  isRead     Boolean             @default(false) @map("is_read")
  images     FeedbackFormMedia[]
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime?           @map("updated_at")
  deletedAt  DateTime?           @map("deleted_at")

  @@index([id])
  @@map("feedback_forms")
}

model FeedbackFormMedia {
  id        Int          @id @default(autoincrement())
  form      FeedbackForm @relation(fields: [formId], references: [id])
  formId    Int          @map("follower_id")
  media     MediaFile    @relation(fields: [mediaId], references: [id])
  mediaId   Int
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime?    @map("updated_at")

  @@index([id])
  @@map("feedback_form_medias")
}

model User {
  id             String     @id
  email          String     @unique
  password       String
  firstName      String     @map("first_name")
  lastName       String?    @map("last_name")
  status         Status     @relation(fields: [statusId], references: [id])
  statusId       Int        @map("status_id")
  role           Role       @relation(fields: [roleId], references: [id])
  roleId         String     @map("role_id")
  profilePhoto   MediaFile? @relation(fields: [profilePhotoId], references: [id])
  profilePhotoId Int?       @map("profile_photo_id")
  content        Content[]
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime?  @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  @@index([email, id])
  @@map("users")
}

model Category {
  id        Int               @id @default(autoincrement())
  name      String
  content   ContentCategory[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime?         @map("updated_at")
  deletedAt DateTime?         @map("deleted_at")

  @@map("categories")
}

model Tag {
  id        Int          @id @default(autoincrement())
  name      String
  content   ContentTag[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime?    @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@map("tags")
}

model Content {
  id          String            @id
  type        String?
  title       String
  excerpt     String?
  slug        String?
  body        String?           @db.Text()
  bodyHtml    String?           @map("body_html") @db.Text()
  link        String?
  thumbnail   MediaFile?        @relation(fields: [thumbnailId], references: [id])
  thumbnailId Int?              @map("thumbnail_id")
  status      Status            @relation(fields: [statusId], references: [id])
  statusId    Int               @map("status_id")
  author      User?             @relation(fields: [authorId], references: [id])
  authorId    String?           @map("author_id")
  categories  ContentCategory[]
  tags        ContentTag[]
  medias      ContentMedia[]
  seoTitleId  String?           @map("seo_title_id")
  seoDescId   String?           @map("seo_desc_id")
  seoTitleEn  String?           @map("seo_title_en")
  seoDescEn   String?           @map("seo_desc_en")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime?         @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  @@map("contents")
}

model ContentCategory {
  id         Int       @id @default(autoincrement())
  content    Content   @relation(fields: [contentId], references: [id])
  contentId  String
  category   Category  @relation(fields: [categoryId], references: [id])
  categoryId Int
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@map("content_categories")
}

model ContentTag {
  id        Int       @id @default(autoincrement())
  content   Content   @relation(fields: [contentId], references: [id])
  contentId String
  tag       Tag       @relation(fields: [tagId], references: [id])
  tagId     Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("content_tags")
}

model ContentMedia {
  id        Int       @id @default(autoincrement())
  content   Content   @relation(fields: [contentId], references: [id])
  contentId String
  media     MediaFile @relation(fields: [mediaId], references: [id])
  mediaId   Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("content_media")
}

model Province {
  id        String @id
  name      String
  latitude  Float
  longitude Float
  cities    City[]

  @@map("provinces")
}

model City {
  id         String     @id
  province   Province   @relation(fields: [provinceId], references: [id])
  provinceId String     @map("province_id")
  name       String
  latitude   Float
  longitude  Float
  districts  District[]

  @@map("cities")
}

model District {
  id        String  @id
  city      City    @relation(fields: [regencyId], references: [id])
  regencyId String  @map("regency_id")
  name      String
  latitude  Float
  longitude Float
  urbans    Urban[]

  @@map("districts")
}

model Urban {
  id         String   @id
  district   District @relation(fields: [districtId], references: [id])
  districtId String   @map("district_id")
  name       String
  latitude   Float
  longitude  Float

  @@map("urbans")
}
